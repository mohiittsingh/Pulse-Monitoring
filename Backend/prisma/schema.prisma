enum MonitorStatus {
  UP
  DEGRADED
  DOWN
}

model Monitor {
  id           String        @id @default(uuid())
  name         String
  url          String
  status       MonitorStatus @default(UP)
  failureCount Int           @default(0)
  lastChecked  DateTime?
}